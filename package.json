{
  "name": "vizulla",
  "productName": "Vizulla",
  "version": "0.4.7",
  "description": "Vizulla: a lightweight, AI-native browser on Chromium (Blink + V8).",
  "private": true,
  "main": "out/main/main.js",
  "author": "Vizulla Product & Engineering",
  "license": "UNLICENSED",
  "scripts": {
    "vz": "node tools/vz.mjs",
    "build": "node tools/vz.mjs build",
    "start": "node tools/vz.mjs run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node tools/vz.mjs build && playwright test",
    "test:cloud": "cd cloud && go test ./...",
    "lint": "node tools/vz.mjs lint",
    "sbom": "node tools/sbom.mjs",
    "lists": "node tools/lists.mjs",
    "package": "node tools/vz.mjs build --release && electron-builder"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "axe-core": "^4.14.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "@ghostery/adblocker": "^2.20.3",
    "@ghostery/adblocker-content": "^2.20.3",
    "electron-chrome-extensions": "4.10.0",
    "electron-chrome-web-store": "0.13.0",
    "lit": "^3.3.3",
    "pdfjs-dist": "^5.7.284",
    "qrcode-generator": "2.0.4"
  },
  "build": {
    "appId": "org.vizulla.browser",
    "productName": "Vizulla",
    "directories": {
      "output": "out/dist",
      "buildResources": "vizulla/app/icons"
    },
    "files": [
      "out/main/**",
      "out/preload/**",
      "out/utility/**",
      "out/webui/**",
      "out/resources/**",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/pdfjs-dist/**"
    ],
    "protocols": [
      {
        "name": "Web",
        "schemes": [
          "http",
          "https"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "hardenedRuntime": true,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "artifactName": "Vizulla-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Vizulla-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Network;WebBrowser",
      "maintainer": "Vizulla <niyongaboemmy@users.noreply.github.com>",
      "artifactName": "Vizulla-${version}-linux-${arch}.${ext}"
    },
    "publish": null,
    "electronVersion": "45.2.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/niyongaboemmy/vizulla-browser.git"
  },
  "homepage": "https://github.com/niyongaboemmy/vizulla-browser"
}
